import pandas as pd
import matplotlib.pyplot as plt

# Load the CSV file
data = pd.read_csv('data.csv')

# Count the number of survivors and non-survivors
survival_counts = data['Survived'].value_counts()

# Create a bar plot
plt.figure(figsize=(8, 5))
survival_counts.plot(kind='bar', color=['green', 'red'])
plt.title('Survival Counts')
plt.xlabel('Survival Status (0 = Did not survive, 1 = Survived)')
plt.ylabel('Count')
plt.xticks(ticks=[0, 1], labels=['Did not survive', 'Survived'], rotation=0)
plt.grid(axis='y')

# Save the plot
plt.savefig('output.png')
plt.show()

print("Plot created and saved as output.png")
